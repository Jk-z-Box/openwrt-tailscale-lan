#!/bin/sh
set -eu
umask 077
TSLAN_ROOT=${TSLAN_ROOT:-}
# shellcheck source=files/usr/lib/tslan/common.sh
. "$TSLAN_ROOT/usr/lib/tslan/common.sh"
ACTION=${1:-}
case "$ACTION" in start|stop|restart|apply|login|logout|boot|diagnose|set|passwd|password-off|uninstall) :;; *) die "Usage: tslan-control start|stop|restart|apply|login|logout|diagnose";; esac
shift
mkdir -p "$TSLAN_RUN"
if ! mkdir "$TSLAN_RUN/lock" 2>/dev/null; then die "Another Tailscale operation is running"; fi
# Used by restore_network() from the shared library.
# shellcheck disable=SC2034
BACKUP=
NETWORK_TRANSACTION=0
finish() {
	result=$?
	trap - EXIT
	if [ "$result" -ne 0 ] && [ "$NETWORK_TRANSACTION" = 1 ]; then
		restore_network
		uci -q revert tslan 2>/dev/null || true
		[ ! -f "$BACKUP/tslan" ] || cp -p "$BACKUP/tslan" "$TSLAN_ROOT/etc/config/tslan"
		load_settings
		configure_web
	fi
	printf '%s\n' "$result" > "$TSLAN_RUN/last-exit"
	rm -rf "$TSLAN_RUN/lock"
	exit "$result"
}
trap finish EXIT
trap 'exit 130' INT TERM
printf '%s\n' "$$" > "$TSLAN_RUN/lock/pid"
# boot is a root-only procd entry point. It only reapplies saved settings.
case "$ACTION" in boot|diagnose) :;; *)
	if [ "${1:-}" = --ticket ]; then
		[ "$#" -ge 2 ] || die 'Missing ticket'
		auth_consume_ticket "$2"; shift 2
	else auth_require; fi
	;;
esac
load_settings
case "$ACTION" in
	passwd) auth_new_password; write_report; say '管理密码已启用'; exit 0;;
	password-off) rm -f "$TSLAN_DATA/password"; write_report; say '管理密码已关闭'; exit 0;;
	uninstall)
		# shellcheck source=files/usr/lib/tslan/uninstall.sh
		. "$TSLAN_LIBDIR/uninstall.sh"
		uninstall_integration
		exit 0;;
esac
if [ "$ACTION" != boot ] && [ "$ACTION" != diagnose ]; then
	[ -z "$(uci -q changes tslan)" ] || die 'Save/revert pending tslan changes first'
	check_conflicts
	snapshot
	NETWORK_TRANSACTION=1
fi
if [ "$ACTION" = set ]; then
	WEB_ONLY=1
	[ "$#" -gt 0 ] || die 'No settings provided'
	for pair in "$@"; do
		case "$pair" in *=*) key=${pair%%=*}; value=${pair#*=};; *) die 'Expected key=value';; esac
		case "$key" in
			enabled|lan_ipv4|lan_ipv6|web_visible|accept_dns|accept_routes|shields_up|bypass_passwall2)
				bool "$value" || die 'Expected 0 or 1';;
			hostname|lan_network) :;;
			*) die "Unknown setting: $key";;
		esac
		if [ "$key" != web_visible ] && [ "$(get "tslan.settings.$key")" != "$value" ]; then WEB_ONLY=0; fi
		uci set "tslan.settings.$key=$value"
	done
	load_settings
	if [ "$WEB_ONLY" = 1 ]; then
		uci commit tslan
		configure_web
		NETWORK_TRANSACTION=0
		write_report
		exit 0
	fi
	# Validate and configure before committing the candidate settings.
fi
case "$ACTION" in
	diagnose)
		say '=== Tailscale ==='
		tailscale status || true
		say '=== IPv4 forwarding / policy routes ==='
		sysctl net.ipv4.ip_forward
		ip -4 rule show
		ip -4 route show table 52 || true
		say '=== Local IPv4 / IPv6 addresses and effective peer routes ==='
		host_stack_status || true
		ip -4 addr show dev tailscale0 || true
		ip -6 addr show dev tailscale0 || true
		ip -6 rule show || true
		ip -6 route show table 52 || true
		say '=== IPv6 global/default and tailscale0 settings (read-only) ==='
		for device in all default tailscale0; do
			for option in disable_ipv6 disable_policy accept_ra autoconf forwarding; do
				sysctl "net.ipv6.conf.$device.$option" 2>/dev/null || true
			done
		done
		say '=== Managed configuration ==='
		uci show network.tslan
		uci show firewall.tslan
		uci show firewall.tslan_lan 2>/dev/null || true
		printf 'LAN IPv4=%s IPv6=%s; Web=%s; password=%s\n' "$LAN4" "$LAN6" "$WEB_VISIBLE" "$(auth_enabled && printf enabled || printf disabled)"
		say '=== PassWall2 bypass guard ==='
		"$TSLAN_ROOT/usr/libexec/tslan-passwall2" status
		say '=== Note ==='
		say 'Actual LAN -> peer reachability must be tested from a LAN device to an allowed peer service.'
		;;
	stop|logout)
		if [ "$ACTION" = logout ]; then
			"$TSLAN_ROOT/etc/init.d/tailscale" start
			wait_daemon
			tailscale logout
		else
			tailscale down 2>/dev/null || true
		fi
		uci set tslan.settings.enabled=0
		uci commit tslan
		ENABLED=0
		"$TSLAN_ROOT/etc/init.d/tailscale" stop
		"$TSLAN_ROOT/etc/init.d/tailscale" disable
		configure_bypass
		NETWORK_TRANSACTION=0
		write_report
		;;
	*)
		if [ "$ACTION" = start ] || [ "$ACTION" = restart ] || [ "$ACTION" = login ]; then
			ENABLED=1
			uci set tslan.settings.enabled=1
			uci commit tslan
		fi
		# A single init service owns startup; the packaged daemon init stays intact.
		"$TSLAN_ROOT/etc/init.d/tailscale" disable
		sh "$TSLAN_ROOT/etc/rc.common" "$TSLAN_ROOT/etc/init.d/tslan" enable
		check_conflicts
		check_ipv6_support
		if [ "$ACTION" != boot ]; then
			configure_network
			uci commit tslan
			configure_web
			NETWORK_TRANSACTION=0
		fi
		if [ "$ENABLED" = 0 ]; then
			tailscale down 2>/dev/null || true
			"$TSLAN_ROOT/etc/init.d/tailscale" stop
			configure_bypass
			write_report
			exit 0
		fi
		start_client
		if [ "$ACTION" = login ]; then
			state=$(tailscale status --json 2>/dev/null | jsonfilter -e '@.BackendState')
			case "$state" in
				NeedsLogin|NoState)
					# The auth URL remains visible in status after this bounded wait.
					set -- --timeout=15s "--accept-dns=$([ "$ACCEPT_DNS" = 1 ] && echo true || echo false)" \
						"--accept-routes=$([ "$ACCEPT_ROUTES" = 1 ] && echo true || echo false)" \
						"--shields-up=$([ "$SHIELDS_UP" = 1 ] && echo true || echo false)" --netfilter-mode=off
					[ -z "$HOSTNAME" ] || set -- "$@" "--hostname=$HOSTNAME"
					tailscale up "$@" || {
							url=$(tailscale status --json 2>/dev/null | jsonfilter -e '@.AuthURL')
							[ -n "$url" ] || die "Could not obtain login URL; see operation log"
						}
					;;
			esac
		fi
		[ "$ACTION" = boot ] || write_report
		;;
esac
