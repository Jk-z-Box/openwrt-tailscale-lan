#!/bin/sh /etc/rc.common
# rc.common consumes these service metadata variables.
# shellcheck disable=SC2034
START=95
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/tslan-control boot
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# Do not change the enabled preference on shutdown.
	/etc/init.d/tailscale stop
	/etc/init.d/tslan-bypass stop
}

reload_service() {
	/usr/libexec/tslan-control apply
}
