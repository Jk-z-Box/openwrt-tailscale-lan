#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034
START=94
# shellcheck disable=SC2034
STOP=9
# shellcheck disable=SC2034
USE_PROCD=1

start_service() {
	[ "$(uci -q get tslan.settings.enabled)" = 1 ] || return 0
	[ "$(uci -q get tslan.settings.bypass_passwall2)" = 1 ] || return 0
	rm -f /var/run/tslan/passwall2.paused
	procd_open_instance
	procd_set_param command /usr/libexec/tslan-passwall2 watch
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	mkdir -p /var/run/tslan
	touch /var/run/tslan/passwall2.paused
	/usr/libexec/tslan-passwall2 remove
}
